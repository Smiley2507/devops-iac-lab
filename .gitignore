# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which are likely to contain sensitive data
# Comment out if you actually want to commit sensitive tfvars for this lab
# *.tfvars
# *.tfvars.json

# Ignore override files as they are usually used to override resources locally
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Never commit generated private keys
*.pem

# Ignore lock info files (not the dependency lock file)
.terraform.tfstate.lock.info